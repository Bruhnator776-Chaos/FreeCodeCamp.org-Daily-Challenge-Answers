"""
Given a string of words, return a new string with the words in reverse order.

- In the given string, words can be separated by one or more spaces.
- The returned string should only have one space between words.
"""

# CODE #

reverse_sentence = lambda sentence: ' '.join(filter(lambda x:x!='', sentence.split(' ')[::-1])) # Split the sentence by the spaces, remove empty strings, then rejoin the words seperated by singular spaces
