"""
Given a word or sentence and a string of lowercase letters, determine if the word or sentence uses all the letters from the given set at least once and no other letters.

- Ignore non-alphabetical characters in the word or sentence.
- Ignore letter casing in the word or sentence.
"""

# CODE #

is_pangram = lambda sentence, letters: set(filter(lambda x:x.isalpha(), list(sentence.lower()))) == set(filter(lambda x:x.isalpha(), list(letters.lower()))) # Convert each argument into a set of letters, then return a boolean depending on the similarity of the two arguments.
