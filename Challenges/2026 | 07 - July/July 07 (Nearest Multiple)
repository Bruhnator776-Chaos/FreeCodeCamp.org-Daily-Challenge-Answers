"""
Given two integers, round the first to the nearest multiple of the second.
"""

# CODE #

def round_to_nearest_multiple(num, multiple):
    multiples = [0] # Create a base list to hold the multiples
    while multiples[-1] < num: multiples.append(multiples[-1]+multiple) # Add every multiple from 0 up past the num
    diffs = [max([num,multiple])-min([num,multiple]) for multiple in multiples[-2:]] # Collect the differences between the num and the multiple from 1 above and 1 below the num
    return multiples[-2:][diffs.index(min(diffs))] # Return the multiple with the lower difference
