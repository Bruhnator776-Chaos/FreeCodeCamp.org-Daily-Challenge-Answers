"""
Given an array of integers representing the price of different laptops, and an integer representing your budget, return:
1) The second most expensive laptop if it is within your budget, or
2) The most expensive laptop that is within your budget, or
3) 0 if no laptops are within your budget.

- Duplicate prices should be ignored.
"""

# CODE #

def get_laptop_cost(laptops, budget):
    budget_laptops = sorted(list(filter(lambda x:x<=budget, list(set(laptops))))) # Create a sorted list of laptops that fit within the budget, ignoring duplicates
    return laptops[-2] if budget_laptops==sorted(laptops) else (0 if budget_laptops==[] else budget_laptops[-1]) # If the budget laptops list and the laptops list are the same, return the second most expensive laptop, otherwise: if the budget_laptops list is empty, return 0, otherwise return the last laptop in the budget list
